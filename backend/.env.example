# Copy to .env (or export) — every variable is optional.

# SQLite file (default: backend/fireflies.db)
# DATABASE_URL=sqlite:////absolute/path/to/fireflies.db

# Load the demo meetings when the database is empty (default: true)
SEED_ON_STARTUP=true

# Comma-separated origins allowed to call the API directly (the Next.js app proxies, so this is rarely needed)
CORS_ORIGINS=http://localhost:3000

# Enables Claude-written notes and AskFred answers; without it the offline heuristics are used
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5
